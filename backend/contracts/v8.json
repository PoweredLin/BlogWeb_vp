    "library": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "demo": {
          "default": false,
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "enum": [
            "番剧",
            "Galgame",
            "游戏",
            "书籍",
            "电影"
          ]
        },
        "creator": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "status": {
          "type": "string",
          "enum": [
            "wish",
            "playing",
            "done",
            "paused"
          ]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "total": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "rating": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "tags": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "note": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "cover": {
          "default": "/assets/flower-03.webp",
          "type": "string",
          "pattern": "^\\/(assets|uploads)\\/[\\w.-]+$"
        },
        "favorite": {
          "default": false,
          "type": "boolean"
        },
        "route": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "character": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "quote": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "title",
        "kind",
        "status",
        "progress",
        "total"
      ]
    },
    "notes": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "demo": {
          "default": false,
          "type": "boolean"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "date",
        "title",
        "content"
      ]
    },
    "posts": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "demo": {
          "default": false,
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,100}$"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "maxLength": 200000
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tags": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "cover": {
          "default": "",
          "type": "string",
          "pattern": "^$|^\\/(assets|uploads)\\/[\\w.-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "published",
            "private",
            "scheduled"
          ]
        },
        "publishAt": {
          "type": "string"
        },
        "featured": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "default": 1,
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 3
            }
          ]
        },
        "origin_url": {
          "default": "",
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "order": {
          "default": null,
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title",
        "slug",
        "excerpt",
        "content",
        "category",
        "status",
        "publishAt"
      ]
    }
  },
  "profileSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
