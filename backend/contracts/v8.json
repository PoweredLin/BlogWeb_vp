        "enum": [
          "landscape-fields",
          "landscape-room",
          "landscape-study",
          "landscape-dawn",
          "landscape-fantasy",
          "landscape-journey",
          "landscape-orbit",
          "landscape-eye",
          "landscape-games",
          "dimension-sunset",
          "dimension-blue",
          "dimension-gold",
          "dimension-violet",
          "dimension-pink"
        ]
      },
      "blogWallpaper": {
        "default": "dimension-sunset",
        "type": "string",
        "enum": [
          "landscape-fields",
          "landscape-room",
          "landscape-study",
          "landscape-dawn",
          "dimension-sunset",
          "dimension-blue",
          "dimension-gold",
          "dimension-violet",
          "dimension-pink"
        ]
      },
      "voice": {
        "default": "greeting-00",
        "type": "string",
        "pattern": "^greeting-(0[0-9]|1[0-8])$"
      },
      "stepsGoal": {
        "type": "number",
        "minimum": 1,
        "maximum": 100000
      },
      "sleepGoal": {
        "type": "number",
        "minimum": 1,
        "maximum": 24
      },
      "waterGoal": {
        "type": "number",
        "minimum": 1,
        "maximum": 20000
      }
    },
    "required": [
      "name",
      "tagline",
      "bio",
      "interests",
      "favoriteAnime",
      "favoriteGames",
      "season",
      "accent",
      "scene",
      "stepsGoal",
      "sleepGoal",
      "waterGoal"
    ]
  },
