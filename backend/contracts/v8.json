{
  "schemas": {
    "tasks": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "demo": {
          "default": false,
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project": {
          "default": "日常",
          "type": "string",
          "maxLength": 20000
        },
        "priority": {
          "default": "normal",
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "status": {
          "default": "todo",
          "type": "string",
          "enum": [
            "todo",
            "doing",
            "done"
          ]
        },
        "due": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "note": {
          "default": "",
          "type": "string",
          "maxLength": 20000
        },
        "completed": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "title",
        "due"
      ]
    },
    "habits": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "demo": {
          "default": false,
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": [
            "boolean",
            "count",
            "number"
          ]
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "checks": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      },
      "required": [
        "title",
        "type",
        "target",
        "unit"
      ]
    },
