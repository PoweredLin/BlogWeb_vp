# Copy to .env beside compose.yaml. Never commit the real .env.
# Docker Compose reads this file. Direct Python startup also loads it.
APP_ENV=production
HOST=127.0.0.1
PORT=4317
SITE_URL=https://lolicong.xyz
COOKIE_SECURE=true
FORWARDED_ALLOW_IPS=172.30.17.1
# Optional: absolute persistent directories (defaults are project/data and project/backups).
# DATA_DIR=/www/wwwroot/lin-notebook/data
# BACKUP_DIR=/www/wwwroot/lin-notebook/backups
# Optional GitHub token, read only on the server. Never place it in browser code.
# GITHUB_TOKEN=
